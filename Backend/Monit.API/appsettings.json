{
  "Jwt": {
    "Issuer": "monit-erp-api",
    "Audience": "monit-erp-frontend",
    "AccessTokenExpiryHours": 8,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3001" ]
  },
  "Export": {
    "CompanyName": "Monit Paper Agency",
    "CompanyAddress": "Indore, Madhya Pradesh"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/monit-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
